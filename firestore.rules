rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function validProfile(data) {
      return data.keys().hasOnly([
          'username', 'displayName', 'bio', 'photoUrl', 'createdAt'
        ])
        && data.keys().hasAll([
          'username', 'displayName', 'bio', 'photoUrl', 'createdAt'
        ])
        && data.username is string
        && data.username.matches('^[a-z0-9_]{3,20}$')
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 50
        && data.bio is string
        && data.bio.size() <= 160
        && data.photoUrl is string
        && data.photoUrl.size() <= 2048;
    }

    match /profiles/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == userId
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // Public encryption keys only. NEVER store private keys in Firestore.
    // The published public key is immutable. There is intentionally no
    // client-side key reset or replacement without a recovery protocol.
    match /secretKeys/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
            'version', 'publicKey', 'createdAt'
          ])
        && request.resource.data.keys().hasAll([
            'version', 'publicKey', 'createdAt'
          ])
        && request.resource.data.version == 1
        && request.resource.data.publicKey is string
        && request.resource.data.publicKey.size() == 44
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    function validConnection(data, connectionId) {
      return data.keys().hasOnly([
          'members', 'senderId', 'receiverId', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'members', 'senderId', 'receiverId', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.senderId is string
        && data.receiverId is string
        && data.senderId != data.receiverId
        && data.members is list
        && data.members.size() == 2
        && data.members[0] is string
        && data.members[1] is string
        && data.members[0] != data.members[1]
        && data.senderId in data.members
        && data.receiverId in data.members
        // Require canonical sorted pair, so neither side can create duplicates.
        && data.members[0] < data.members[1]
        && connectionId == data.members[0] + '_' + data.members[1]
        && data.status == 'pending'
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    match /connections/{connectionId} {
      // Queries must filter with where('members', arrayContains: auth.uid).
      allow get, list: if signedIn()
        && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && validConnection(request.resource.data, connectionId)
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.receiverId));

      // Only the recipient can accept/decline a pending invitation.
      allow update: if signedIn()
        && resource.data.receiverId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt']);

      allow delete: if false;

      function acceptedMember() {
        return signedIn()
          && exists(/databases/$(database)/documents/connections/$(connectionId))
          && get(/databases/$(database)/documents/connections/$(connectionId)).data.status == 'accepted'
          && request.auth.uid in get(/databases/$(database)/documents/connections/$(connectionId)).data.members;
      }

      function validMessage(data) {
        return data.text is string
          && data.text.size() > 0
          && data.text.size() <= 2000;
      }

      // Standard chat attachments use Cloud Storage. Never store download
      // tokens/URLs in Firestore: clients load using authenticated Storage SDK.
      function validMedia(data, messageId) {
        return data.keys().hasOnly([
            'senderId', 'mediaType', 'storagePath', 'mediaSize',
            'contentType', 'createdAt'
          ])
          && data.keys().hasAll([
            'senderId', 'mediaType', 'storagePath', 'mediaSize',
            'contentType', 'createdAt'
          ])
          && data.senderId == request.auth.uid
          && data.createdAt == request.time
          && data.mediaType in ['image', 'video', 'audio']
          && data.storagePath is string
          && data.storagePath.size() <= 250
          && data.storagePath.matches(
            'connections/' + connectionId + '/' + request.auth.uid
              + '/' + messageId + '[.](jpg|jpeg|png|webp|mp4|mov|m4a)'
          )
          && data.mediaSize is int
          && data.mediaSize > 0
          && data.contentType is string
          && (
            (data.mediaType == 'image'
              && data.mediaSize <= 3 * 1024 * 1024
              && data.contentType in [
                'image/jpeg', 'image/png', 'image/webp'
              ]
              && data.storagePath.matches('.*[.](jpg|jpeg|png|webp)'))
            || (data.mediaType == 'video'
              && data.mediaSize <= 12 * 1024 * 1024
              && data.contentType in ['video/mp4', 'video/quicktime']
              && data.storagePath.matches('.*[.](mp4|mov)'))
            || (data.mediaType == 'audio'
              && data.mediaSize <= 2 * 1024 * 1024
              && data.contentType == 'audio/mp4'
              && data.storagePath.matches('.*[.]m4a'))
          );
      }

      match /messages/{messageId} {
        allow get, list: if acceptedMember();
        allow create: if acceptedMember()
          && (
            (request.resource.data.keys().hasOnly([
                'senderId', 'text', 'createdAt'
              ])
              && request.resource.data.keys().hasAll([
                'senderId', 'text', 'createdAt'
              ])
              && request.resource.data.senderId == request.auth.uid
              && validMessage(request.resource.data)
              && request.resource.data.createdAt == request.time)
            || validMedia(request.resource.data, messageId)
          );

        // Sender can edit text; other fields, including senderId, are immutable.
        allow update: if acceptedMember()
          && resource.data.senderId == request.auth.uid
          && resource.data.keys().hasAny(['text'])
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['text', 'editedAt'])
          && request.resource.data.editedAt == request.time
          && validMessage(request.resource.data);

        // A recipient may mark a message seen once; no other changes allowed.
        allow update: if acceptedMember()
          && resource.data.senderId != request.auth.uid
          && !resource.data.keys().hasAny(['readAt'])
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;

        // Deletion removes a message for every participant's live listener.
        allow delete: if acceptedMember()
          && resource.data.senderId == request.auth.uid;
      }

      // Secret text is separate from standard plaintext /messages.
      // Only participants can read; only the authenticated sender can create.
      // Secret messages are immutable in this first text-only implementation.
      match /secretMessages/{messageId} {
        allow get, list: if acceptedMember();
        allow create: if acceptedMember()
          && request.resource.data.keys().hasOnly([
              'version', 'senderId', 'createdAt',
              'ciphertext', 'nonce', 'mac'
            ])
          && request.resource.data.keys().hasAll([
              'version', 'senderId', 'createdAt',
              'ciphertext', 'nonce', 'mac'
            ])
          && request.resource.data.version == 1
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.ciphertext is string
          && request.resource.data.ciphertext.size() > 0
          && request.resource.data.ciphertext.size() <= 20000
          && request.resource.data.nonce is string
          && request.resource.data.nonce.size() == 16
          && request.resource.data.mac is string
          && request.resource.data.mac.size() == 24;
        allow update, delete: if false;
      }

      // Short-lived typing state, editable only by its account owner.
      // The other accepted contact can observe it, but cannot forge it.
      match /typing/{userId} {
        allow get, list: if acceptedMember();
        allow create, update: if acceptedMember()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['typing', 'updatedAt'])
          && request.resource.data.keys().hasAll(['typing', 'updatedAt'])
          && request.resource.data.typing is bool
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }
  }
}
